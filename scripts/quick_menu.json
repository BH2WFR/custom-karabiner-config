        {
            "title": "Test live output (10 seconds)",
            "command": "for i in {1..10}; do if (( i % 2 )); then /bin/date '+%Y-%m-%d %H:%M:%S'; else /bin/date '+%Y-%m-%d %H:%M:%S' >&2; fi; /bin/sleep 1; done",
            "output": "gui"
        }
